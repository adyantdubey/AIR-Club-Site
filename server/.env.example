# Copy this file to .env and fill in the values.

PORT=4000

# Where form submissions are emailed to
CONTACT_TO=airclub@nitandhra.ac.in

# SMTP settings (for Gmail: create an "App password" in your Google account, then use it here)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourclubemail@gmail.com
SMTP_PASS=your-app-password

# In development, leave this empty to just log emails to the console instead of sending
# Set to "true" to actually send
SEND_EMAILS=false

# Comma-separated list of allowed origins for the API (only needed if client and server are on different domains)
CORS_ORIGINS=http://localhost:5173
